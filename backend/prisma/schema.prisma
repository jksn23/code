// This is your Prisma schema file (Prisma v5)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Kategori {
  id        Int        @id @default(autoincrement())
  nama      String     @unique @db.VarChar(100)
  kriteria     Kriteria[]
  aset         Aset[]
  bobotVersion BobotVersion[]
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@map("kategori")
}

model Kriteria {
  id         Int          @id @default(autoincrement())
  kategoriId Int          @map("kategori_id")
  nama       String       @db.VarChar(150)
  tipe       TipeKriteria
  kategori   Kategori     @relation(fields: [kategoriId], references: [id], onDelete: Cascade)
  nilaiAset  NilaiAset[]
  bobotAhp   BobotAHP[]
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  @@map("kriteria")
}

model Aset {
  id                    Int              @id @default(autoincrement())
  nama                  String           @db.VarChar(200)
  kategoriId            Int              @map("kategori_id")
  penjualId             Int?             @map("penjual_id")
  deskripsi             String?          @db.Text
  dokumenUrl            String?          @map("dokumen_url") @db.VarChar(255)
  statusLelang          StatusLelang     @default(DRAFT) @map("status_lelang")
  statusPenilaian       StatusPenilaian  @default(DRAFT) @map("status_penilaian")
  catatanPenilaian      String?          @map("catatan_penilaian") @db.Text
  penilaianSubmittedAt  DateTime?        @map("penilaian_submitted_at")
  penilaianReviewedAt   DateTime?        @map("penilaian_reviewed_at")
  penilaianReviewedBy   Int?             @map("penilaian_reviewed_by")
  hargaPasar            Decimal          @map("harga_pasar") @db.Decimal(20, 2)
  limitValue            Decimal?         @map("limit_value") @db.Decimal(20, 2)

  kategori  Kategori    @relation(fields: [kategoriId], references: [id], onDelete: Cascade)
  penjual   Penjual?    @relation(fields: [penjualId], references: [id], onDelete: SetNull)
  nilaiAset NilaiAset[]
  hasil     Hasil[]
  lelang    Lelang[]
  dataPembanding DataPembanding[]
  documents Document[]

  assetProperty   AssetProperty?
  assetVehicle    AssetVehicle?
  assetElectronic AssetElectronic?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("aset")
}

model NilaiAset {
  id         Int      @id @default(autoincrement())
  asetId     Int      @map("aset_id")
  kriteriaId Int      @map("kriteria_id")
  nilai      Decimal  @db.Decimal(15, 4)
  aset       Aset     @relation(fields: [asetId], references: [id], onDelete: Cascade)
  kriteria   Kriteria @relation(fields: [kriteriaId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([asetId, kriteriaId])
  @@map("nilai_aset")
}

model BobotAHP {
  id         Int      @id @default(autoincrement())
  versionId  Int      @map("version_id")
  kriteriaId Int      @map("kriteria_id")
  bobot      Decimal  @db.Decimal(10, 6)
  
  version    BobotVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  kriteria   Kriteria     @relation(fields: [kriteriaId], references: [id], onDelete: Cascade)
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  @@map("bobot_ahp")
}

model BobotVersion {
  id              Int      @id @default(autoincrement())
  kategoriId      Int      @map("kategori_id")
  namaVersi       String   @db.VarChar(100)
  jumlahPakar     Int?     @map("jumlah_pakar")
  lambdaMax       Decimal? @db.Decimal(10, 6)
  ci              Decimal? @db.Decimal(10, 6)
  ri              Decimal? @db.Decimal(10, 6)
  cr              Decimal  @db.Decimal(10, 6)
  tanggalValidasi DateTime? @map("tanggal_validasi")
  aktif           Boolean  @default(false)
  catatan         String?  @db.Text
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  kategori        Kategori @relation(fields: [kategoriId], references: [id], onDelete: Cascade)
  bobotAhp        BobotAHP[]

  @@map("bobot_version")
}

model Hasil {
  id                  Int      @id @default(autoincrement())
  asetId              Int      @map("aset_id")
  nilaiPreferensi     Decimal  @map("nilai_preferensi") @db.Decimal(15, 6)
  hargaReferensiPasar Decimal? @map("harga_referensi_pasar") @db.Decimal(20, 2)
  nilaiLimit          Decimal  @map("nilai_limit") @db.Decimal(20, 2)
  aset                Aset     @relation(fields: [asetId], references: [id], onDelete: Cascade)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@map("hasil")
}

enum TipeKriteria {
  benefit
  cost
}

enum Role {
  ADMIN
  PENJUAL
  PEMBELI
}

enum BuyerVerificationStatus {
  UNVERIFIED
  PENDING
  APPROVED
  REJECTED
}

enum SellerVerificationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum StatusLelang {
  DRAFT
  PENDING
  ACTIVE
  FINISHED
}

enum StatusPenilaian {
  DRAFT
  MENUNGGU_VERIFIKASI
  DISETUJUI
  PERLU_REVISI
  DITOLAK
}

enum StatusValidasiPembanding {
  MENUNGGU
  DITERIMA
  DITOLAK
}

model DataPembanding {
  id              Int                      @id @default(autoincrement())
  asetId          Int                      @map("aset_id")
  judul           String                   @db.VarChar(255)
  sumber          String                   @db.VarChar(100)
  sourceUrl       String                   @map("source_url") @db.VarChar(255)
  harga           Decimal                  @db.Decimal(20, 2)
  lokasi          String?                  @db.VarChar(150)
  tahun           Int?
  kondisi         String?                  @db.VarChar(100)
  spesifikasi     String?                  @db.Text
  skorKecocokan   Decimal?                 @map("skor_kecocokan") @db.Decimal(5, 2)
  similarity      Decimal?                 @db.Decimal(5, 4)    // Fuse.js fuzzy match score 0.0-1.0
  isOutlier       Boolean                  @default(false) @map("is_outlier")   // IQR outlier flag
  statusValidasi  StatusValidasiPembanding @default(MENUNGGU) @map("status_validasi")
  dipilihPenjual  Boolean                  @default(false) @map("dipilih_penjual")
  scrapedAt       DateTime                 @default(now()) @map("scraped_at")
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt

  aset            Aset                     @relation(fields: [asetId], references: [id], onDelete: Cascade)

  @@map("data_pembanding")
}


model User {
  id                      Int                     @id @default(autoincrement())
  email                   String                  @unique @db.VarChar(100)
  password                String                  @db.VarChar(255)
  nama                    String                  @db.VarChar(150)
  role                    Role                    @default(PEMBELI)
  ktpUrl                  String?                 @map("ktp_url") @db.VarChar(255)
  buyerVerificationStatus BuyerVerificationStatus @default(UNVERIFIED) @map("buyer_verification_status")
  buyerVerificationNote   String?                 @map("buyer_verification_note") @db.Text
  buyerVerifiedAt         DateTime?               @map("buyer_verified_at")
  buyerVerifiedBy         Int?                    @map("buyer_verified_by")
  createdAt               DateTime                @default(now())
  updatedAt               DateTime                @updatedAt

  penjual              Penjual?
  penawaran            Penawaran[]
  lelangDimenangkan    Lelang[]     @relation("LelangPemenang")
  verifiedPayments     Lelang[]     @relation("PaymentVerifier")
  notifications        Notifikasi[]
  buyerVerifier        User?        @relation("BuyerVerifier", fields: [buyerVerifiedBy], references: [id], onDelete: SetNull)
  verifiedBuyers       User[]       @relation("BuyerVerifier")
  verifiedSellers      Penjual[]    @relation("SellerVerifier")
  QuickBid             QuickBid[]
  dokumenDigenerate    Dokumen[]          @relation("DokumenGenerator")
  documentsOwned       Document[]         @relation("DocumentOwner")
  documentsUploaded    Document[]         @relation("DocumentUploader")
  documentsVerified    Document[]         @relation("DocumentVerifier")
  documentActivities   DocumentActivity[]
  documentTemplates    DocumentTemplate[]

  @@map("users")
}

model Penjual {
  id                 Int                      @id @default(autoincrement())
  userId             Int                      @unique @map("user_id")
  ktpUrl             String?                  @map("ktp_url") @db.VarChar(255)
  npwpUrl            String?                  @map("npwp_url") @db.VarChar(255)
  rekeningBank       String?                  @map("rekening_bank") @db.VarChar(100)
  nomorRekening      String?                  @map("nomor_rekening") @db.VarChar(100)
  isVerified         Boolean                  @default(false) @map("is_verified")
  verificationStatus SellerVerificationStatus @default(PENDING) @map("verification_status")
  verificationNote   String?                  @map("verification_note") @db.Text
  verifiedAt         DateTime?                @map("verified_at")
  verifiedBy         Int?                     @map("verified_by")

  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  verifier User?  @relation("SellerVerifier", fields: [verifiedBy], references: [id], onDelete: SetNull)
  aset     Aset[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("penjual")
}

model Lelang {
  id                          Int          @id @default(autoincrement())
  asetId                      Int          @map("aset_id")
  waktuBuka                   DateTime?    @map("waktu_buka")
  waktuTutup                  DateTime?    @map("waktu_tutup")
  durasiMenit                 Int          @default(60) @map("durasi_menit")
  status                      StatusLelang @default(PENDING)
  pemenangId                  Int?         @map("pemenang_id")
  statusPembayaran            String       @default("UNPAID") @map("status_pembayaran") @db.VarChar(20)
  invoiceNumber               String?      @unique @map("invoice_number") @db.VarChar(80)
  invoiceGeneratedAt          DateTime?    @map("invoice_generated_at")
  paymentDueDate              DateTime?    @map("payment_due_date")
  buktiBayarUrl               String?      @map("bukti_bayar_url") @db.VarChar(255)
  tanggalUploadBukti          DateTime?    @map("tanggal_upload_bukti")
  tanggalVerifikasiPembayaran DateTime?    @map("tanggal_verifikasi_pembayaran")
  catatanPembayaran           String?      @map("catatan_pembayaran") @db.Text
  verifiedBy                  Int?         @map("verified_by")
  statusBarang                String       @default("PENDING") @map("status_barang") @db.VarChar(20)

  aset                  Aset        @relation(fields: [asetId], references: [id], onDelete: Cascade)
  penawaran             Penawaran[]
  pemenang              User?       @relation("LelangPemenang", fields: [pemenangId], references: [id], onDelete: SetNull)
  verifikatorPembayaran User?       @relation("PaymentVerifier", fields: [verifiedBy], references: [id], onDelete: SetNull)
  dokumen               Dokumen[]
  documentsRepo         Document[]

  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  QuickBid  QuickBid[]

  @@map("lelang")
}

model Penawaran {
  id       Int     @id @default(autoincrement())
  lelangId Int     @map("lelang_id")
  userId   Int     @map("user_id")
  nominal  Decimal @db.Decimal(20, 2)

  lelang Lelang @relation(fields: [lelangId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("penawaran")
}

model Notifikasi {
  id            Int      @id @default(autoincrement())
  userId        Int      @map("user_id")
  judul         String   @db.VarChar(150)
  pesan         String   @db.Text
  tipe          String   @db.VarChar(50)
  isRead        Boolean  @default(false) @map("is_read")
  referenceType String?  @map("reference_type") @db.VarChar(50)
  referenceId   Int?     @map("reference_id")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@map("notifikasi")
}

model AssetProperty {
  id                Int      @id @default(autoincrement())
  asetId            Int      @unique @map("aset_id")
  certificateNumber String   @map("certificate_number") @db.VarChar(100)
  ownerName         String   @map("owner_name") @db.VarChar(150)
  landArea          Decimal  @map("land_area") @db.Decimal(10, 2)
  buildingArea      Decimal? @map("building_area") @db.Decimal(10, 2)
  village           String   @db.VarChar(100)
  district          String   @db.VarChar(100)
  city              String   @db.VarChar(100)
  province          String   @db.VarChar(100)
  njopPerM2         Decimal  @map("njop_per_m2") @db.Decimal(20, 2)
  basePropertyValue Decimal  @map("base_property_value") @db.Decimal(20, 2)
  certificateFile   String   @map("certificate_file") @db.VarChar(255)
  propertyPhoto     String   @map("property_photo") @db.VarChar(255)

  aset Aset @relation(fields: [asetId], references: [id], onDelete: Cascade)

  @@map("asset_properties")
}

model AssetVehicle {
  id            Int    @id @default(autoincrement())
  asetId        Int    @unique @map("aset_id")
  brand         String @db.VarChar(100)
  type          String @db.VarChar(100)
  year          Int
  color         String @db.VarChar(50)
  plateNumber   String @map("plate_number") @db.VarChar(20)
  engineNumber  String @map("engine_number") @db.VarChar(50)
  chassisNumber String @map("chassis_number") @db.VarChar(50)
  vehiclePhoto  String @map("vehicle_photo") @db.VarChar(255)
  bpkbFile      String @map("bpkb_file") @db.VarChar(255)
  stnkFile      String @map("stnk_file") @db.VarChar(255)

  aset Aset @relation(fields: [asetId], references: [id], onDelete: Cascade)

  @@map("asset_vehicles")
}

model AssetElectronic {
  id        Int    @id @default(autoincrement())
  asetId    Int    @unique @map("aset_id")
  brand     String @db.VarChar(100)
  series    String @db.VarChar(100)
  type      String @db.VarChar(100)
  itemPhoto String @map("item_photo") @db.VarChar(255)

  aset Aset @relation(fields: [asetId], references: [id], onDelete: Cascade)

  @@map("asset_electronics")
}

model QuickBid {
  id        Int      @id @default(autoincrement())
  buyerId   Int      @map("buyer_id")
  auctionId Int      @map("auction_id")
  quickBid1 Decimal  @map("quick_bid_1") @db.Decimal(20, 2)
  quickBid2 Decimal  @map("quick_bid_2") @db.Decimal(20, 2)
  quickBid3 Decimal  @map("quick_bid_3") @db.Decimal(20, 2)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User   @relation(fields: [buyerId], references: [id], onDelete: Cascade)
  lelang Lelang @relation(fields: [auctionId], references: [id], onDelete: Cascade)

  @@unique([buyerId, auctionId])
  @@map("quick_bids")
}

enum TipeDokumen {
  SURAT_PENETAPAN
  BERITA_ACARA
  DOKUMEN_HASIL_LELANG
  SURAT_PERMOHONAN
}

model Dokumen {
  id           Int          @id @default(autoincrement())
  lelangId     Int          @map("lelang_id")
  tipe         TipeDokumen
  namaFile     String       @map("nama_file") @db.VarChar(255)
  filePath     String       @map("file_path") @db.VarChar(500)
  generatedBy  Int          @map("generated_by")
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  lelang       Lelang       @relation(fields: [lelangId], references: [id], onDelete: Cascade)
  generator    User         @relation("DokumenGenerator", fields: [generatedBy], references: [id], onDelete: Cascade)

  @@map("dokumen")
}

model PenilaianAuditLog {
  id            Int      @id @default(autoincrement())
  asetId        Int      @map("aset_id")
  userId        Int      @map("user_id")
  role          Role
  aksi          String   @db.VarChar(100)
  nilaiSebelum  Json?    @map("nilai_sebelum")
  nilaiSesudah  Json?    @map("nilai_sesudah")
  waktu         DateTime @default(now())

  @@index([asetId])
  @@map("penilaian_audit_log")
}

enum DocumentType {
  // Penjual
  KTP_PENJUAL
  NPWP_PENJUAL
  SURAT_KUASA
  SURAT_PERMOHONAN_LELANG
  SURAT_PERNYATAAN
  DAFTAR_BARANG
  BUKTI_REKENING
  // Aset
  FOTO_ASET
  DOKUMEN_KEPEMILIKAN
  // Pengumuman
  BUKTI_PENGUMUMAN
  // Pembeli
  KTP_PEMBELI
  NPWP_PEMBELI
  BUKTI_PEMBAYARAN
  // Sistem / Generated
  SURAT_PENETAPAN_LELANG
  BERITA_ACARA
  NOTA_PEMBAYARAN
  RINGKASAN_HASIL_LELANG
}

enum DocumentStatus {
  DRAFT
  UPLOADED
  PENDING_VERIFICATION
  APPROVED
  REJECTED
  ARCHIVED
}

model Document {
  id               Int            @id @default(autoincrement())
  ownerId          Int?           @map("owner_id")
  auctionId        Int?           @map("auction_id")
  assetId          Int?           @map("asset_id")
  documentType     DocumentType   @map("document_type")
  fileName         String         @map("file_name") @db.VarChar(255)
  originalFileName String?        @map("original_file_name") @db.VarChar(255)
  storagePath      String         @map("storage_path") @db.VarChar(500)
  mimeType         String?        @map("mime_type") @db.VarChar(100)
  fileSize         Int?           @map("file_size")
  version          Int            @default(1)
  status           DocumentStatus @default(PENDING_VERIFICATION)
  verificationNote String?        @map("verification_note") @db.Text
  uploadedBy       Int            @map("uploaded_by")
  verifiedBy       Int?           @map("verified_by")
  verifiedAt       DateTime?      @map("verified_at")
  deletedAt        DateTime?      @map("deleted_at")
  createdAt        DateTime       @default(now()) @map("created_at")
  updatedAt        DateTime       @updatedAt @map("updated_at")

  owner      User?    @relation("DocumentOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  uploader   User     @relation("DocumentUploader", fields: [uploadedBy], references: [id], onDelete: Cascade)
  verifier   User?    @relation("DocumentVerifier", fields: [verifiedBy], references: [id], onDelete: SetNull)
  lelang     Lelang?  @relation(fields: [auctionId], references: [id], onDelete: Cascade)
  aset       Aset?    @relation(fields: [assetId], references: [id], onDelete: Cascade)

  activities DocumentActivity[]

  @@map("documents")
}

model DocumentActivity {
  id         Int      @id @default(autoincrement())
  documentId Int      @map("document_id")
  action     String   @db.VarChar(50)  // UPLOAD, VERIFY, REJECT, REUPLOAD, GENERATE, DOWNLOAD, ARCHIVE
  actorId    Int      @map("actor_id")
  note       String?  @db.Text
  createdAt  DateTime @default(now()) @map("created_at")

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  actor    User     @relation(fields: [actorId], references: [id], onDelete: Cascade)

  @@map("document_activities")
}

model DocumentTemplate {
  id           Int          @id @default(autoincrement())
  name         String       @db.VarChar(150)
  documentType DocumentType @map("document_type")
  filePath     String       @map("file_path") @db.VarChar(500)
  placeholders Json?
  uploadedBy   Int          @map("uploaded_by")
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")

  uploader User @relation(fields: [uploadedBy], references: [id], onDelete: Cascade)

  @@map("document_templates")
}

